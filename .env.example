# ---------------------------------------------------------------------------
# Appium server
# ---------------------------------------------------------------------------
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723

# ---------------------------------------------------------------------------
# Timeouts (seconds)
# ---------------------------------------------------------------------------
WAIT_TIMEOUT=10

# ---------------------------------------------------------------------------
# Target: emulator | real_device | browserstack
# ---------------------------------------------------------------------------
TARGET=emulator

# ---------------------------------------------------------------------------
# App under test
# Absolute path to the APK.  Defaults to calculator.apk in the project root.
# ---------------------------------------------------------------------------
APP_PATH=/absolute/path/to/calculator.apk

# ---------------------------------------------------------------------------
# Emulator config  (required when TARGET=emulator)
# ---------------------------------------------------------------------------
AVD_NAME=Pixel_9_2

# ---------------------------------------------------------------------------
# Real device config  (required when TARGET=real_device)
# ---------------------------------------------------------------------------
DEVICE_UDID=your_device_udid
DEVICE_NAME=your_device_name

# ---------------------------------------------------------------------------
# BrowserStack  (required when TARGET=browserstack)
# Get your credentials at https://www.browserstack.com/accounts/profile
# ---------------------------------------------------------------------------
BS_USERNAME=your_username
BS_ACCESS_KEY=your_access_key
BUILD_NAME=local
BROWSERSTACK_DEVICE=Google Pixel 9
BROWSERSTACK_OS_VERSION=15.0
# bs:// URL returned by the BrowserStack upload API; takes priority over APP_PATH when set.
BROWSERSTACK_APP_URL=

# ---------------------------------------------------------------------------
# MCP servers
# ---------------------------------------------------------------------------

# appium-mcp: path to Android SDK root and an Appium capabilities JSON file
ANDROID_HOME=/path/to/android/sdk
CAPABILITIES_CONFIG=/absolute/path/to/capabilities.json

# github-mcp: personal access token with repo/issues/PR scopes
# Create one at https://github.com/settings/tokens
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_pat
